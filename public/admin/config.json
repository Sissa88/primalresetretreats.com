{
  "backend": {
    "name": "github",
    "repo": "Sissa88/primalresetretreats.com",
    "branch": "main",
    "auth_endpoint": "api/auth",
    "auth_scope": "public_repo"
  },
  "load_config_file": false,
  "media_folder": "public/uploads",
  "public_folder": "/uploads",
  "slug": {
    "encoding": "ascii",
    "clean_accents": true,
    "sanitize_replacement": "-"
  },
  "collections": [
    {
      "name": "settings",
      "label": "Website settings",
      "files": [
        {
          "name": "settings",
          "label": "Contact, forms, and domain",
          "file": "content/settings.json",
          "fields": [
            {
              "name": "site_name",
              "label": "Site Name",
              "widget": "string"
            },
            {
              "name": "site_url",
              "label": "Public website URL (https://...)",
              "widget": "string",
              "required": false,
              "hint": "Set this after connecting your domain."
            },
            {
              "name": "contact_email",
              "label": "Contact email",
              "widget": "string",
              "required": false
            },
            {
              "name": "retreat_form_id",
              "label": "Formspree ID for retreat inquiries",
              "widget": "string",
              "required": false,
              "hint": "Just the ID after /f/, not the full URL."
            },
            {
              "name": "coach_form_id",
              "label": "Formspree ID for coach applications",
              "widget": "string",
              "required": false
            },
            {
              "name": "allow_indexing",
              "label": "Allow search engines to index this site",
              "widget": "boolean",
              "default": false
            },
            {
              "name": "show_booking_button",
              "label": "Show the booking button",
              "widget": "boolean",
              "default": true
            },
            {
              "name": "booking_button_label",
              "label": "Booking button text",
              "widget": "string",
              "default": "Book now",
              "hint": "Opens the pricing and room-selection page. Payment is not connected yet."
            },
            {
              "name": "contact_form_provider",
              "label": "Contact form service when no Formspree ID is set",
              "widget": "select",
              "options": [
                {
                  "label": "FormSubmit \u2014 verify the contact email first",
                  "value": "formsubmit"
                },
                {
                  "label": "Disabled \u2014 email link only",
                  "value": "disabled"
                }
              ],
              "default": "formsubmit",
              "hint": "Formspree IDs, when present, take priority. FormSubmit sends to the Contact email above."
            }
          ]
        }
      ]
    },
    {
      "name": "faq",
      "label": "Frequently asked questions",
      "files": [
        {
          "name": "faq",
          "label": "Questions and answers",
          "file": "content/faq.json",
          "fields": [
            {
              "name": "eyebrow",
              "label": "Section label",
              "widget": "string"
            },
            {
              "name": "heading",
              "label": "Section heading",
              "widget": "string"
            },
            {
              "name": "items",
              "label": "Questions",
              "widget": "list",
              "collapsed": true,
              "summary": "{{fields.question}}",
              "fields": [
                {
                  "name": "question",
                  "label": "Question",
                  "widget": "string"
                },
                {
                  "name": "answer",
                  "label": "Answer",
                  "widget": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "pricing",
      "label": "Pricing & rooms",
      "files": [
        {
          "name": "pricing",
          "label": "Room prices, photos, and promotion",
          "file": "content/pricing.json",
          "fields": [
            {
              "name": "title",
              "label": "Page title",
              "widget": "string"
            },
            {
              "name": "description",
              "label": "Search description",
              "widget": "text"
            },
            {
              "name": "eyebrow",
              "label": "Retreat dates and location",
              "widget": "string"
            },
            {
              "name": "heading",
              "label": "Headline, first line",
              "widget": "string"
            },
            {
              "name": "heading_emphasis",
              "label": "Headline, second line",
              "widget": "string"
            },
            {
              "name": "intro",
              "label": "Introductory text",
              "widget": "text"
            },
            {
              "name": "hero_image",
              "label": "Hero image",
              "widget": "image"
            },
            {
              "name": "hero_alt",
              "label": "Hero image description",
              "widget": "string"
            },
            {
              "name": "location",
              "label": "Location",
              "widget": "string"
            },
            {
              "name": "room_intro",
              "label": "Room introduction",
              "widget": "text"
            },
            {
              "name": "currency",
              "label": "Currency",
              "widget": "hidden",
              "default": "USD"
            },
            {
              "name": "deposit_percent",
              "label": "Planned deposit percentage",
              "widget": "number",
              "value_type": "float",
              "min": 1,
              "max": 100,
              "step": 0.01
            },
            {
              "name": "promo_enabled",
              "label": "Offer a promotion",
              "widget": "boolean"
            },
            {
              "name": "promo_code",
              "label": "Promotion code",
              "widget": "string",
              "hint": "Public preview code, not a password. No payment is collected."
            },
            {
              "name": "promo_percent",
              "label": "Promotion discount percentage",
              "widget": "number",
              "value_type": "float",
              "min": 0,
              "max": 100,
              "step": 0.01
            },
            {
              "name": "promo_description",
              "label": "Promotion instructions",
              "widget": "text"
            },
            {
              "name": "balance_note",
              "label": "Balance Note",
              "widget": "string"
            },
            {
              "name": "availability_note",
              "label": "Availability explanation",
              "widget": "text"
            },
            {
              "name": "booking_note",
              "label": "Preview and booking status",
              "widget": "text"
            },
            {
              "name": "closing_heading",
              "label": "Closing Heading",
              "widget": "string"
            },
            {
              "name": "closing_text",
              "label": "Closing Text",
              "widget": "text"
            },
            {
              "name": "rooms",
              "label": "The two room options",
              "widget": "list",
              "allow_add": false,
              "min": 2,
              "max": 2,
              "collapsed": true,
              "summary": "{{fields.name}} \u2014 ${{fields.price}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "name",
                  "label": "Room name",
                  "widget": "string"
                },
                {
                  "name": "badge",
                  "label": "Short tagline",
                  "widget": "string"
                },
                {
                  "name": "description",
                  "label": "Description",
                  "widget": "text"
                },
                {
                  "name": "price",
                  "label": "Package price per person (USD)",
                  "widget": "number",
                  "value_type": "float",
                  "min": 0.01,
                  "max": 1000000,
                  "step": 0.01
                },
                {
                  "name": "capacity",
                  "label": "Planned total allotment",
                  "widget": "string"
                },
                {
                  "name": "image",
                  "label": "Main room photo",
                  "widget": "image"
                },
                {
                  "name": "image_alt",
                  "label": "Describe the main photo",
                  "widget": "string"
                },
                {
                  "name": "features",
                  "label": "Room features",
                  "widget": "list",
                  "field": {
                    "name": "feature",
                    "label": "Feature",
                    "widget": "string"
                  }
                },
                {
                  "name": "photos",
                  "label": "Additional room photos",
                  "widget": "list",
                  "fields": [
                    {
                      "name": "image",
                      "label": "Image",
                      "widget": "image"
                    },
                    {
                      "name": "alt",
                      "label": "Photo description",
                      "widget": "string"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "coaches",
      "label": "Coach profiles",
      "files": [
        {
          "name": "coaches",
          "label": "Photos and biographies",
          "file": "content/coaches.json",
          "fields": [
            {
              "name": "coaches",
              "label": "Coaches",
              "widget": "list",
              "collapsed": true,
              "summary": "{{fields.name}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "name",
                  "label": "Name",
                  "widget": "string"
                },
                {
                  "name": "role",
                  "label": "Role or title",
                  "widget": "string"
                },
                {
                  "name": "specialties",
                  "label": "Areas of experience",
                  "widget": "text"
                },
                {
                  "name": "bio",
                  "label": "Biography",
                  "widget": "text"
                },
                {
                  "name": "image",
                  "label": "Portrait",
                  "widget": "image"
                },
                {
                  "name": "image_alt",
                  "label": "Portrait description",
                  "widget": "string"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "existing",
      "label": "Existing pages",
      "files": [
        {
          "name": "home",
          "label": "Home",
          "file": "content/pages/home.json",
          "fields": [
            {
              "name": "title",
              "label": "Page title",
              "widget": "string"
            },
            {
              "name": "description",
              "label": "Search description",
              "widget": "text"
            },
            {
              "name": "texts",
              "label": "Page text",
              "widget": "list",
              "allow_add": false,
              "collapsed": true,
              "summary": "{{fields.label}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "label",
                  "label": "Text location",
                  "widget": "hidden"
                },
                {
                  "name": "value",
                  "label": "Text",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "images",
              "label": "Page images",
              "widget": "list",
              "allow_add": false,
              "collapsed": true,
              "summary": "{{fields.alt}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "src",
                  "label": "Image",
                  "widget": "image"
                },
                {
                  "name": "alt",
                  "label": "Image description",
                  "widget": "string"
                }
              ]
            }
          ]
        },
        {
          "name": "coach-with-us",
          "label": "Coach with us",
          "file": "content/pages/coach-with-us.json",
          "fields": [
            {
              "name": "title",
              "label": "Page title",
              "widget": "string"
            },
            {
              "name": "description",
              "label": "Search description",
              "widget": "text"
            },
            {
              "name": "texts",
              "label": "Page text",
              "widget": "list",
              "allow_add": false,
              "collapsed": true,
              "summary": "{{fields.label}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "label",
                  "label": "Text location",
                  "widget": "hidden"
                },
                {
                  "name": "value",
                  "label": "Text",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "images",
              "label": "Page images",
              "widget": "list",
              "allow_add": false,
              "collapsed": true,
              "summary": "{{fields.alt}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "hidden"
                },
                {
                  "name": "src",
                  "label": "Image",
                  "widget": "image"
                },
                {
                  "name": "alt",
                  "label": "Image description",
                  "widget": "string"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "retreats",
      "label": "Retreats",
      "folder": "content/retreats",
      "create": true,
      "delete": false,
      "extension": "json",
      "format": "json",
      "slug": "{{slug}}",
      "summary": "{{title}} \u2014 {{dates}}",
      "fields": [
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "summary",
          "label": "Summary",
          "widget": "text"
        },
        {
          "name": "image",
          "label": "Image",
          "widget": "image"
        },
        {
          "name": "dates",
          "label": "Dates",
          "widget": "string",
          "default": "Dates announced soon"
        },
        {
          "name": "duration",
          "label": "Duration",
          "widget": "string",
          "default": "7 days"
        },
        {
          "name": "location",
          "label": "Location",
          "widget": "string",
          "default": "Big Island \u00b7 Hawai\u02bbi"
        },
        {
          "name": "capacity",
          "label": "Capacity",
          "widget": "string",
          "default": "Small group"
        },
        {
          "name": "price",
          "label": "Price",
          "widget": "string",
          "default": "Pricing to be confirmed"
        },
        {
          "name": "published",
          "label": "Show on website",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "description",
          "label": "Search description",
          "widget": "text",
          "required": false
        },
        {
          "name": "body",
          "label": "Retreat description",
          "widget": "markdown",
          "required": false
        },
        {
          "name": "texts",
          "label": "Page text",
          "widget": "list",
          "allow_add": false,
          "collapsed": true,
          "summary": "{{fields.label}}",
          "fields": [
            {
              "name": "id",
              "label": "Id",
              "widget": "hidden"
            },
            {
              "name": "label",
              "label": "Text location",
              "widget": "hidden"
            },
            {
              "name": "value",
              "label": "Text",
              "widget": "text"
            }
          ],
          "required": false,
          "hint": "Existing retreat only: edit its original sections here. New retreats use the description above."
        },
        {
          "name": "images",
          "label": "Page images",
          "widget": "list",
          "allow_add": false,
          "collapsed": true,
          "summary": "{{fields.alt}}",
          "fields": [
            {
              "name": "id",
              "label": "Id",
              "widget": "hidden"
            },
            {
              "name": "src",
              "label": "Image",
              "widget": "image"
            },
            {
              "name": "alt",
              "label": "Image description",
              "widget": "string"
            }
          ],
          "required": false
        }
      ]
    },
    {
      "name": "pages",
      "label": "Additional pages",
      "folder": "content/pages",
      "create": true,
      "extension": "json",
      "format": "json",
      "slug": "{{slug}}",
      "filter": {
        "field": "type",
        "value": "custom"
      },
      "fields": [
        {
          "name": "type",
          "label": "Type",
          "widget": "hidden",
          "default": "custom"
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "description",
          "label": "Search description",
          "widget": "text",
          "required": false
        },
        {
          "name": "published",
          "label": "Show on website",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "body",
          "label": "Page content",
          "widget": "markdown"
        }
      ]
    }
  ]
}
